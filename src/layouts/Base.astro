---
import "@/styles/global.css";
import { getImage } from "astro:assets";
import portrait from "@/images/portrait.jpeg";
import { SITE, TABS, FOOTER_LINKS, UI, DEFAULT_LOCALE, otherLocale, withLocale, stripLocale } from "@/lib/site";
import type { Locale } from "@/lib/site";
import { websiteSchema } from "@/lib/structured-data";

interface Props {
  title: string;
  description?: string;
  active?: string;
  width?: "content" | "wide";
  /** "article" for blog posts; adds article: OpenGraph tags. */
  type?: "website" | "article";
  /** Absolute image URL; falls back to a site-wide portrait crop. */
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  structuredData?: object | object[];
  /** Full URL path of this page in each locale, when it isn't the same canonical route in all of them (blog posts). */
  alternates?: Partial<Record<Locale, string>>;
  /** For pages that shouldn't be indexed (404): no canonical, no hreflang. */
  noindex?: boolean;
}

const locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const site = SITE[locale];
const tabs = TABS[locale];
const footerLinks = FOOTER_LINKS[locale];
const ui = UI[locale];

const {
  title,
  description = site.tagline,
  active,
  width = "content",
  type = "website",
  image,
  publishedTime,
  modifiedTime,
  structuredData,
  alternates,
  noindex = false,
} = Astro.props;
const mainWidth = width === "wide" ? "max-w-wide" : "max-w-content";
const fonts =
  "https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400&display=swap";
const focus =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";

const { path } = stripLocale(Astro.url.pathname);
const target = otherLocale(locale);
// A page is either the same canonical route in every locale, or names its own
// translations. With no translation the switch falls back to the blog index and
// no hreflang alternate is emitted.
const localizedPath = (code: Locale) => alternates?.[code] ?? (alternates ? undefined : withLocale(path, code));
const languages: { code: Locale; name: string }[] = [
  { code: "en", name: "English" },
  { code: "pt", name: "Português" },
];

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: portrait, width: 1200, height: 630, fit: "cover" });
const imageUrl = image ?? new URL(ogImage.src, Astro.site).toString();
const ogLocale = (l: Locale) => (l === "pt" ? "pt_PT" : "en_US");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    websiteSchema(locale, Astro.site!),
    ...(Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : []),
  ],
};
---

<!doctype html>
<html lang={locale === "pt" ? "pt-PT" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {!noindex && localizedPath("en") && <link rel="alternate" hreflang="en" href={new URL(localizedPath("en")!, Astro.site)} />}
    {!noindex && localizedPath("pt") && <link rel="alternate" hreflang="pt-PT" href={new URL(localizedPath("pt")!, Astro.site)} />}
    {!noindex && localizedPath("en") && <link rel="alternate" hreflang="x-default" href={new URL(localizedPath("en")!, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={site.name} href={footerLinks.find((l) => l.label === "rss")!.href} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(target)} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.name} />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <script is:inline>
      // Applied before first paint so the theme never flashes.
      try {
        const stored = localStorage.getItem("theme");
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch (e) {}
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class:list={["sr-only focus:not-sr-only focus:absolute focus:m-4 focus:bg-secondary focus:px-3 focus:py-2 focus:no-underline", focus]}
      >{ui.skipToContent}</a
    >

    <header class="border-b border-border">
      <div class="mx-auto flex max-w-wide flex-wrap items-end justify-between gap-6 px-6 py-6">
        <div class="flex flex-col gap-2">
          <a href={withLocale("/", locale)} class:list={["display-l font-serif text-foreground no-underline", focus]}>
            {site.name}
          </a>
          <span class="h-0.5 w-8 bg-primary" aria-hidden="true"></span>
          <p class="body-s m-0 max-w-content text-muted-foreground">{site.tagline}</p>
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
          <nav aria-label="Sections">
            <ul class="m-0 flex list-none items-center gap-6 p-0">
              {
                tabs.map((tab) => (
                  <li>
                    <a
                      href={tab.href}
                      aria-current={active === tab.id ? "page" : undefined}
                      class:list={[
                        "nav border-b-2 border-transparent pb-2 text-meta-foreground no-underline transition-colors hover:text-foreground aria-[current=page]:border-primary aria-[current=page]:text-foreground",
                        focus,
                      ]}
                    >
                      {tab.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="flex items-center gap-6">
            <div role="group" aria-label={ui.language} class="flex items-stretch rounded-lg border border-input">
              {
                languages.map(({ code, name }) => (
                  <a
                    href={localizedPath(code) ?? withLocale("/blog", code)}
                    hreflang={code}
                    lang={code}
                    title={name}
                    aria-label={name}
                    aria-current={code === locale ? "true" : undefined}
                    class:list={[
                      "meta px-2 py-1 leading-none no-underline transition-colors first:rounded-l-md first:border-r first:border-input last:rounded-r-md",
                      code === locale
                        ? "bg-secondary text-foreground"
                        : "text-meta-foreground hover:bg-accent hover:text-foreground",
                      focus,
                    ]}
                  >
                    {code}
                  </a>
                ))
              }
            </div>

            <button
              id="theme-toggle"
              type="button"
              class:list={["rounded-lg border border-input px-2 py-1 leading-none text-meta-foreground transition-colors hover:text-foreground", focus]}
              aria-label={ui.switchTheme}
              title={ui.switchTheme}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                aria-hidden="true"
                class="block"
              >
                <circle cx="12" cy="12" r="4.5"></circle>
                <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="main" class:list={["mx-auto w-full flex-1 px-6 py-12", mainWidth]}>
      <slot />
    </main>

    <footer class="mt-16 border-t border-border bg-secondary">
      <div class="mx-auto flex max-w-wide flex-wrap justify-between gap-4 px-6 py-8">
        <p class="body-s m-0 text-meta-foreground">{site.footerNote}</p>
        <ul class="m-0 flex list-none flex-wrap gap-4 p-0">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  rel={link.external ? "noreferrer me" : undefined}
                  class:list={["label text-meta-foreground no-underline hover:text-primary-strong hover:underline hover:underline-offset-2", focus]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </footer>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("theme", dark ? "dark" : "light");
        } catch (e) {}
      });
    </script>
  </body>
</html>
