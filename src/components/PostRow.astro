---
import { formatDate } from "@/lib/site";

interface Props {
  title: string;
  href: string;
  date: Date;
  category: "software" | "travel" | "personal";
  summary?: string;
}

const { title, href, date, category, summary } = Astro.props;

// The dot is a second signal, never the only one — the word always ships with it.
const DOT = {
  software: "bg-tag-software",
  travel: "bg-tag-travel",
  personal: "bg-tag-personal",
};
---

<li data-category={category} class="border-t border-border first:border-t-0">
  <a
    href={href}
    class="group -mx-4 block rounded-lg p-4 no-underline transition-colors hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
  >
    <div class="meta mb-2 flex items-center gap-3 text-meta-foreground">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span class="inline-flex items-center gap-1">
        <span class:list={["size-1.5 rounded-full", DOT[category]]} aria-hidden="true"></span>
        {category}
      </span>
    </div>
    <h3 class="display-s m-0 font-serif text-foreground transition-colors group-hover:text-primary-strong">{title}</h3>
    {summary && <p class="body-base m-0 mt-2 text-muted-foreground">{summary}</p>}
  </a>
</li>
