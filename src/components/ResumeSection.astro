---
import type { Entry } from "@/lib/resume";
import { UI, DEFAULT_LOCALE } from "@/lib/site";
import type { Locale } from "@/lib/site";

interface Props {
  title: string;
  entries: Entry[];
}

const { title, entries } = Astro.props;
const locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const toolsLabel = UI[locale].resume.tools;
---

<section class="mt-12 first:mt-0">
  <h2 class="meta m-0 border-b border-border pb-2 text-foreground">{title}</h2>

  {
    entries.map((entry) => (
      <article class="mt-8">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h3 class="display-m m-0 font-serif text-foreground">{entry.role}</h3>
          <span class="tabular whitespace-nowrap text-meta-foreground">{entry.period}</span>
        </div>

        {(entry.org || entry.location) && (
          <p class="body-base m-0 mt-1 text-muted-foreground">
            {entry.org}
            {entry.location && ` · ${entry.location}`}
          </p>
        )}

        {entry.bullets && (
          <ul class="body-base mt-3 list-disc pl-5 text-muted-foreground">
            {entry.bullets.map((b) => (
              <li class="mt-2 first:mt-0">{b}</li>
            ))}
          </ul>
        )}

        {entry.tech && (
          <ul class="mt-3 flex list-none flex-wrap gap-2 p-0" aria-label={toolsLabel}>
            {entry.tech.map((t) => (
              <li class="rounded-sm border border-border px-1.5 py-px font-mono text-xs text-meta-foreground">
                {t}
              </li>
            ))}
          </ul>
        )}
      </article>
    ))
  }
</section>
