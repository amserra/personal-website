---
import Base from "@/layouts/Base.astro";
import ResumeSection from "@/components/ResumeSection.astro";
import { buttonVariants } from "@/components/ui/button";
import FilterChip from "@/components/FilterChip.astro";
import { getImage } from "astro:assets";
import portrait from "@/images/portrait.jpeg";
import { EXPERIENCE, EDUCATION, PROJECTS, SKILLS } from "@/lib/resume";
import { UI, DEFAULT_LOCALE, withLocale } from "@/lib/site";
import type { Locale } from "@/lib/site";
import { personSchema } from "@/lib/structured-data";

const locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const ui = UI[locale];

const personUrl = new URL(withLocale("/me", locale), Astro.site);
const portraitImage = await getImage({ src: portrait, width: 800 });
const portraitUrl = new URL(portraitImage.src, Astro.site);
const structuredData = personSchema(locale, personUrl, portraitUrl);
---

<Base
  title={`${ui.resume.metaTitle} — Alexandre Serra`}
  active="resume"
  description={ui.resume.metaDescription}
  structuredData={structuredData}
>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="display-l m-0 font-serif text-foreground">{ui.resume.title}</h1>
      <p class="body-base mt-2 text-muted-foreground">
        {ui.resume.subtitle}
      </p>
    </div>
    <div>
      <!-- The one solid primary fill allowed per page. Hidden until the script runs: the PDF is built in the browser. -->
      <button
        id="cv-download"
        type="button"
        hidden
        class:list={[buttonVariants({ variant: "default" }), "group aria-busy:cursor-progress"]}
        data-locale={locale}
        data-label-professional={ui.resume.downloadCvProfessional}
        data-label-full={ui.resume.downloadCvPersonal}
        data-generating={ui.resume.generatingCv}
        data-error={ui.resume.cvError}
      >
        <svg
          class="hidden animate-spin group-aria-busy:block motion-reduce:animate-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
        </svg>
        <span id="cv-label">{ui.resume.downloadCvProfessional}</span>
      </button>
      <span id="cv-status" role="status" class="sr-only"></span>
      <p id="cv-error" role="alert" class="body-s m-0 mt-2 text-destructive empty:hidden"></p>
    </div>
  </div>

  <!-- Hidden until the script runs: without it the page stays on the professional view. -->
  <div id="view-toggle" role="group" aria-label={ui.resume.viewLabel} class="mt-8 flex flex-wrap gap-3" hidden>
    <FilterChip data-view="professional" pressed>{ui.resume.viewProfessional}</FilterChip>
    <FilterChip data-view="full">{ui.resume.viewFull}</FilterChip>
  </div>

  <!-- Everything is server-rendered; the professional view just hides what is personal. -->
  <div
    id="resume"
    data-view="professional"
    class="mt-12 [&[data-view=professional]_[data-kind=personal]]:hidden"
  >
    <ResumeSection title={ui.resume.experience} entries={EXPERIENCE[locale]} />
    <ResumeSection title={ui.resume.education} entries={EDUCATION[locale]} />
    <ResumeSection title={ui.resume.projects} entries={PROJECTS[locale]} />

    <section class="mt-12" data-kind={SKILLS[locale].some((s) => s.kind === "professional") ? "professional" : "personal"}>
      <h2 class="meta m-0 border-b border-border pb-2 text-foreground">{ui.resume.skills}</h2>
      <dl class="m-0 mt-6 grid gap-4">
        {
          SKILLS[locale].map((s) => (
            <div class="sm:grid sm:grid-cols-[180px_1fr] sm:gap-4" data-kind={s.kind}>
              <dt class="label text-meta-foreground">{s.label}</dt>
              <dd class="body-base m-0 text-muted-foreground">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Base>

<script>
  import type { Locale } from "@/lib/site";

  const root = document.getElementById("resume")!;
  const toggle = document.getElementById("view-toggle")!;
  const buttons = Array.from(toggle.querySelectorAll<HTMLButtonElement>("button"));
  const cvButton = document.getElementById("cv-download")!;
  const cvLabel = document.getElementById("cv-label")!;
  const cvStatus = document.getElementById("cv-status")!;
  const cvError = document.getElementById("cv-error")!;

  const idleLabel = (view: string) =>
    (view === "full" ? cvButton.dataset.labelFull : cvButton.dataset.labelProfessional) ?? "";

  function apply(view: string, push = true) {
    root.dataset.view = view;
    cvLabel.textContent = idleLabel(view);
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.view === view));
    if (push) {
      const url = new URL(location.href);
      view === "professional" ? url.searchParams.delete("view") : url.searchParams.set("view", view);
      history.replaceState({}, "", url);
    }
  }

  cvButton.addEventListener("click", async () => {
    // aria-busy, not disabled: the button keeps its colour and focus while the PDF builds.
    if (cvButton.getAttribute("aria-busy") === "true") return;
    // Lock the width so swapping the label for the shorter "Generating PDF…" doesn't move the button.
    cvButton.style.minWidth = `${cvButton.offsetWidth}px`;
    cvButton.setAttribute("aria-busy", "true");
    cvLabel.textContent = cvButton.dataset.generating ?? "";
    cvStatus.textContent = cvLabel.textContent;
    cvError.textContent = "";
    try {
      const { downloadCv } = await import("@/lib/cv-download");
      await downloadCv({
        locale: cvButton.dataset.locale as Locale,
        view: root.dataset.view === "full" ? "full" : "professional",
        siteUrl: import.meta.env.SITE,
      });
    } catch (err) {
      console.error(err);
      cvError.textContent = cvButton.dataset.error ?? "";
    } finally {
      cvStatus.textContent = "";
      cvLabel.textContent = idleLabel(root.dataset.view ?? "professional");
      cvButton.removeAttribute("aria-busy");
      cvButton.style.minWidth = "";
    }
  });

  cvButton.hidden = false;
  toggle.hidden = false;
  for (const b of buttons) b.addEventListener("click", () => apply(b.dataset.view!));
  if (new URL(location.href).searchParams.get("view") === "full") apply("full", false);
</script>
