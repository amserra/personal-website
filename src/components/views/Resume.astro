---
import Base from "@/layouts/Base.astro";
import ResumeSection from "@/components/ResumeSection.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import { getImage } from "astro:assets";
import portrait from "@/images/portrait.jpeg";
import { EXPERIENCE, EDUCATION, PROJECTS, SKILLS } from "@/lib/resume";
import { UI, DEFAULT_LOCALE, withLocale } from "@/lib/site";
import type { Locale } from "@/lib/site";
import { personSchema } from "@/lib/structured-data";

const locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const ui = UI[locale];

const personUrl = new URL(withLocale("/me", locale), Astro.site);
const portraitImage = await getImage({ src: portrait, width: 800 });
const portraitUrl = new URL(portraitImage.src, Astro.site);
const structuredData = personSchema(locale, personUrl, portraitUrl);
---

<Base
  title={`${ui.resume.metaTitle} — Alexandre Serra`}
  active="resume"
  description={ui.resume.metaDescription}
  structuredData={structuredData}
>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="display-l m-0 font-serif text-foreground">{ui.resume.title}</h1>
      <p class="body-base mt-2 text-muted-foreground">
        {ui.resume.subtitle}
      </p>
    </div>
    <!-- The one solid primary fill allowed per page. -->
    <ButtonLink href="/alexandre-serra-cv.pdf" variant="default" download>{ui.resume.downloadCv}</ButtonLink>
  </div>

  <div class="mt-12">
    <ResumeSection title={ui.resume.experience} entries={EXPERIENCE[locale]} />
    <ResumeSection title={ui.resume.education} entries={EDUCATION[locale]} />
    <ResumeSection title={ui.resume.projects} entries={PROJECTS[locale]} />

    <section class="mt-12">
      <h2 class="meta m-0 border-b border-border pb-2 text-foreground">{ui.resume.skills}</h2>
      <dl class="mt-6 m-0">
        {
          SKILLS[locale].map((s) => (
            <div class="mt-4 first:mt-0 sm:grid sm:grid-cols-[180px_1fr] sm:gap-4">
              <dt class="label text-meta-foreground">{s.label}</dt>
              <dd class="body-base m-0 text-muted-foreground">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Base>
