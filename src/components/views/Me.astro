---
import Base from "@/layouts/Base.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import { Image } from "astro:assets";
import portrait from "@/images/portrait.jpeg";
import { UI, DEFAULT_LOCALE, withLocale } from "@/lib/site";
import type { Locale } from "@/lib/site";

const locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const ui = UI[locale];
---

<Base title={`${ui.me.title} — Alexandre Serra`} active="me" description={ui.me.metaDescription}>
  <h1 class="display-l m-0 font-serif text-foreground">{ui.me.title}</h1>

  <div class="mt-8 grid gap-8 md:grid-cols-[220px_1fr] md:gap-12">
    <Image
      src={portrait}
      alt="Alexandre Serra"
      width={440}
      densities={[1, 2]}
      class="w-full max-w-[220px] bg-muted"
      loading="eager"
    />

    <div class="body-l max-w-content text-foreground">
      {ui.me.paragraphs.map((p, i) => <p class:list={[i === 0 ? "m-0" : "mt-4"]}>{p}</p>)}
    </div>
  </div>

  <div class="mt-12 flex flex-wrap items-center gap-4">
    <ButtonLink href="mailto:me@alexandreserra.com" variant="outline">{ui.me.emailMe}</ButtonLink>
    <ButtonLink href={withLocale("/resume", locale)} variant="link">{ui.me.professionalVersion}</ButtonLink>
  </div>
</Base>
