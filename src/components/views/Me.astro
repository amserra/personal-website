---
import Base from "@/layouts/Base.astro";
import ButtonLink from "@/components/ButtonLink.astro";
import { Image, getImage } from "astro:assets";
import portrait from "@/images/portrait.jpeg";
import { UI, DEFAULT_LOCALE, withLocale } from "@/lib/site";
import type { Locale } from "@/lib/site";
import { personSchema } from "@/lib/structured-data";

const locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE;
const ui = UI[locale];

const personUrl = new URL(withLocale("/me", locale), Astro.site);
const portraitImage = await getImage({ src: portrait, width: 800 });
const portraitUrl = new URL(portraitImage.src, Astro.site);
const structuredData = personSchema(locale, personUrl, portraitUrl);
---

<Base
  title={`${ui.me.metaTitle} — Alexandre Serra`}
  active="me"
  description={ui.me.metaDescription}
  structuredData={structuredData}
>
  <h1 class="display-l m-0 font-serif text-foreground">{ui.me.title}</h1>

  <div class="mt-8 flow-root">
    <Image
      src={portrait}
      alt="Alexandre Serra"
      width={576}
      densities={[1, 2]}
      class="float-left mr-4 mb-2 w-50 rounded-xl bg-muted sm:mr-6 sm:mb-3 sm:w-56 md:w-72"
      loading="eager"
    />

    <div class="body-l max-w-content text-foreground">
      {ui.me.paragraphs.map((p, i) => <p class:list={[i === 0 ? "m-0" : "mt-4"]}>{p}</p>)}
    </div>
  </div>

  <div class="mt-12 flex flex-wrap items-center gap-4">
    <ButtonLink href="mailto:me@alexandreserra.com" variant="outline">{ui.me.emailMe}</ButtonLink>
    <ButtonLink href={withLocale("/resume", locale)} variant="link"
      >{ui.me.professionalVersion}</ButtonLink
    >
  </div>
</Base>
